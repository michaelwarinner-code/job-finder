# Personal data -- never committed, delivered to GitHub Actions as
# encrypted secrets instead, written to disk fresh at the start of each run.
state/eeo_answers.json
state/candidate_info.json

# Google OAuth credentials -- real secrets, not code.
auto-apply/client_secret.json
auto-apply/token.json

# Leftover plaintext encoding output -- never needed once pasted into a
# GitHub secret, and it's a plaintext copy of personal data until deleted.
*_b64.txt

# Generated artifacts -- real resumes, cover letters, and screenshots
# containing personal info, regenerated fresh each run, never need to
# persist in git.
auto-apply/pipeline_output/
auto-apply/test_output/

# Python
__pycache__/
*.pyc

# Node dependencies -- regenerated fresh via `npm install`, never committed.
resume-builder/node_modules/
auto-apply-telegram-worker/node_modules/
